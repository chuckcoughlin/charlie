"""Type stub for booster_agent_framework (available only in robot runtime)."""

from typing import Any, Callable, Sequence

class AgentState:
    kUninitialized: int
    kInactive: int
    kActive: int
    kFinalized: int

class AgentFeatures:
    def __init__(
        self,
        enable_orchestration: bool = True,
        enable_auto_getup: bool = False,
        auto_get_up_shortcut: Any | None = None,
        param_schema_path: str = "",
        enable_telemetry_report: bool = False,
    ) -> None: ...

class LocaleString:
    def __init__(self, en: str, zh: str | None = None) -> None: ...

class Component:
    id: str
    name: LocaleString
    display_sequence: int
    shortcut: Any
    type: int

class IconComponent(Component):
    activated: bool
    need_activate: bool
    path: str

class StateIconComponent(IconComponent):
    state: bool

class DefaultStateIconComponent(StateIconComponent):
    state: bool

class ComponentManager:
    def add_component(self, component: Component) -> None: ...
    def add_components(self, components: Sequence[Component]) -> None: ...
    def get_component(self, component_id: str) -> Component | None: ...
    def get_components(self) -> dict[str, Component]: ...
    def update_component(self, component: Component) -> None: ...
    def remove_component(self, component: Component) -> None: ...
    def push_component_message(self, component: Component, message: Any) -> None: ...
    def publish_toast(self, message: LocaleString, position: int = 0, icon: int = 0) -> None: ...

class Logger:
    def info(self, msg: str) -> None: ...
    def warn(self, msg: str) -> None: ...
    def error(self, msg: str) -> None: ...
    def debug(self, msg: str) -> None: ...

class AgentBase:
    agent_id: str
    agent_state: AgentState
    component_manager: ComponentManager
    logger: Logger
    parameter_manager: Any
    robot_states: Any
    storage_manager: Any

    def __init__(self, agent_features: AgentFeatures) -> None: ...
    def on_agent_activated(self) -> None: ...
    def on_agent_close(self) -> None: ...
    def register_robot_states_callback(self, callback: Callable) -> None: ...
    def call_booster_interface_api(self, loco_api_id: int, body: str, timeout_ms: int) -> tuple[int, str]: ...

class ComponentStatePageProxy:
    active_page: str
    all_components: set[Component]

    def __init__(self, agent: AgentBase) -> None: ...
    def register_page(self, page_id: str, predicate: Callable) -> None: ...
    def register_component(self, page_id: str, component: Component, predicate: Callable | None = None) -> None: ...
    def get_component(self, page_id: str, component_id: str) -> Component | None: ...
    def unregister_component(self, page_id: str, component_id: str) -> None: ...
    def force_update(self) -> None: ...

def get_sys_api_level() -> int: ...
